# Template for Streamlit Community Cloud secrets.
# Paste the real values into: App settings -> Secrets (never commit the real file).
#
# .streamlit/secrets.toml is gitignored. This .example file is safe to commit.

# Your Gemini key. Powers the free demo runs for visitors.
# Leave it out entirely if you want every visitor to supply their own key.
GOOGLE_API_KEY = "AIza...your_key_here"

# How many free runs each visitor session gets on YOUR key before they are
# asked to paste their own. Lower it if your quota is getting drained.
FREE_RUNS_PER_SESSION = "3"

# Model selection.
LLM_MODEL = "gemini-2.0-flash"
LLM_BACKUP_MODEL = "gemini-2.5-flash"

# Agent budget — each iteration costs an LLM call, so keep this small on free tiers.
DEVLOOP_MAX_ITERATIONS = "3"

# Sandbox limits for generated code (no Docker on free hosting).
DEVLOOP_SANDBOX_CPU = "10"
DEVLOOP_SANDBOX_MEM_MB = "512"
