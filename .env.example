# --- Secrets ---
# Get your key at https://aistudio.google.com/
GOOGLE_API_KEY=your_api_key_here

# --- Config ---
LLM_MODEL=gemini-2.0-flash
# Used by the Streamlit agent when the primary model hits a 429 / quota limit.
LLM_BACKUP_MODEL=gemini-2.5-flash
REDIS_URL=redis://devloop-redis:6379/0
RATE_LIMIT_PER_MINUTE=20

# --- Agent tuning ---
# Max self-healing cycles before the agent gives up.
DEVLOOP_MAX_ITERATIONS=5
# Name of the running sandbox container used to execute generated tests.
SANDBOX_CONTAINER_NAME=devloop-sandbox
# Set to 1 to skip the Docker sandbox and run generated tests on the host.
# Convenient locally, but there is NO isolation — do not use with untrusted input.
DEVLOOP_FORCE_LOCAL_TESTS=0
